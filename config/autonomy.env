# ============================================================
# Autonomous Drone Navigation
# Project Configuration
# ============================================================

PROJECT_DIR="$HOME/autonomous-drone-navigation"
ROS_WS="$PROJECT_DIR/drone_ws"

ROS_SETUP="/opt/ros/jazzy/setup.bash"
WS_SETUP="$ROS_WS/install/setup.bash"

SIMULATION_SCRIPT="$PROJECT_DIR/start_simulation.sh"

PACKAGE_NAME="drone_navigation_cpp"

OBSTACLE_DETECTOR="obstacle_detector"
OBSTACLE_AVOIDANCE="obstacle_avoidance"
OFFBOARD_AVOIDANCE="offboard_avoidance"
CAMERA_VIEWER="camera_viewer"

DEPTH_TOPIC="/depth_camera"
OBSTACLE_STATE_TOPIC="/obstacle_state"
AVOIDANCE_COMMAND_TOPIC="/avoidance_command"

PX4_POSITION_TOPIC="/fmu/out/vehicle_local_position_v1"
PX4_SETPOINT_TOPIC="/fmu/in/trajectory_setpoint"

MICROXRCE_PORT="8888"